# Copy to .env.deploy and fill in real values (never commit .env.deploy)
DEPLOY_USER=root
DEPLOY_HOST=your-server-ip
DEPLOY_SSH_KEY=/path/to/your-key.pem
DEPLOY_SLUG=labor-copilot
# Omit --public if deploying a private/unlisted preview link
DEPLOY_PUBLIC=0
# Set to 1 if using SPA history fallback
DEPLOY_SPA=0
